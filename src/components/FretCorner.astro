---
export interface Props {
  position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  size?: number | string;
  class?: string;
}

const { position = 'top-left', size = '80px', class: className = '' } = Astro.props;

const rotations = {
  'top-left': '0deg',
  'top-right': '90deg',
  'bottom-right': '180deg',
  'bottom-left': '270deg'
};

const rotate = rotations[position];
---

<div class={`fret-corner ${className}`} style={`--size: ${typeof size === 'number' ? size + 'px' : size}; --rotate: ${rotate};`}>
  <svg class="fret-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- A simplified Chinese key fret / Huiwen pattern corner -->
    <path class="fret-path" d="M10,10 L90,10 L90,30 L30,30 L30,90 L10,90 Z" />
    <path class="fret-path" d="M50,50 L90,50 L90,70 L50,70 Z" />
    <path class="fret-path" d="M50,90 L70,90 L70,100 L50,100 Z" />
  </svg>
</div>

<style>
  .fret-corner {
    width: var(--size);
    height: var(--size);
    position: absolute;
    transform: rotate(var(--rotate));
    transform-origin: center center;
    opacity: 0.6;
    pointer-events: none;
  }

  .fret-path {
    stroke: var(--cream, #F3E6D0);
    stroke-width: 4;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initFretCorners = () => {
    const corners = document.querySelectorAll('.fret-corner');
    
    corners.forEach((corner) => {
      const paths = corner.querySelectorAll('.fret-path');
      
      gsap.to(paths, {
        strokeDashoffset: 0,
        duration: 1.2,
        ease: 'power3.out',
        stagger: 0.2,
        scrollTrigger: {
          trigger: corner,
          start: 'top 90%',
          once: true
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initFretCorners);
  document.addEventListener('astro:page-load', initFretCorners);
</script>

---
export interface Props {
  opacity?: number;
  class?: string;
}

const { opacity = 0.15, class: className = '' } = Astro.props;
---

<div class={`tile-field-container ${className}`} style={`--opacity: ${opacity};`}>
  <div class="tile-pattern" aria-hidden="true"></div>
</div>

<style>
  .tile-field-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .tile-pattern {
    position: absolute;
    /* Extra height for parallax */
    top: -20%;
    left: 0;
    width: 100%;
    height: 140%;
    opacity: var(--opacity);
    
    /* Recreating Peranakan tiles with a CSS pattern */
    background-color: transparent;
    background-image: 
      /* Tile 1 */
      linear-gradient(45deg, var(--saffron, #E8A33D) 25%, transparent 25%, transparent 75%, var(--saffron, #E8A33D) 75%, var(--saffron, #E8A33D)),
      linear-gradient(45deg, var(--saffron, #E8A33D) 25%, transparent 25%, transparent 75%, var(--saffron, #E8A33D) 75%, var(--saffron, #E8A33D)),
      /* Tile 2 */
      linear-gradient(135deg, var(--indigo, #1E3A5F) 25%, transparent 25%, transparent 75%, var(--indigo, #1E3A5F) 75%, var(--indigo, #1E3A5F)),
      linear-gradient(135deg, var(--indigo, #1E3A5F) 25%, transparent 25%, transparent 75%, var(--indigo, #1E3A5F) 75%, var(--indigo, #1E3A5F)),
      /* Tile 3 */
      radial-gradient(circle, var(--brick, #9E3B22) 15%, transparent 16%);
    
    background-size: 80px 80px;
    background-position: 
      0 0, 40px 40px, 
      0 40px, 40px 0, 
      20px 20px;
      
    /* Mix blend mode for better integration */
    mix-blend-mode: color-dodge;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initTileField = () => {
    const tilePatterns = document.querySelectorAll('.tile-pattern');
    
    tilePatterns.forEach((pattern) => {
      gsap.to(pattern, {
        y: '20%', // Move down slowly as user scrolls down
        ease: 'none',
        scrollTrigger: {
          trigger: pattern.parentElement,
          start: 'top bottom',
          end: 'bottom top',
          scrub: true
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initTileField);
  document.addEventListener('astro:page-load', initTileField);
</script>

---
import FretCorner from './FretCorner.astro';

const SITE = {
  phone: '15551234567', // For WhatsApp, needs to be clean number
};
---

<div id="reserve-modal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-container">
    <FretCorner position="top-left" class="modal-fret" size={50} />
    <FretCorner position="top-right" class="modal-fret" size={50} />
    <FretCorner position="bottom-left" class="modal-fret" size={50} />
    <FretCorner position="bottom-right" class="modal-fret" size={50} />

    <button class="modal-close" aria-label="Close modal">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-content">
      <h2 id="modal-title" class="modal-title">Reserve a Table</h2>
      <p class="modal-desc">Fill out the details below. We'll finalize your reservation via WhatsApp.</p>

      <form id="reserve-form" class="reserve-form">
        <div class="form-group">
          <label for="res-name">Name</label>
          <input type="text" id="res-name" name="name" required placeholder="Jane Doe" />
        </div>

        <div class="form-group">
          <label for="res-phone">Phone (10 digits)</label>
          <input type="tel" id="res-phone" name="phone" required pattern="[0-9]{10}" placeholder="1234567890" />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="res-date">Date</label>
            <input type="date" id="res-date" name="date" required />
          </div>
          <div class="form-group">
            <label for="res-time">Time</label>
            <input type="time" id="res-time" name="time" required />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="res-guests">Guests</label>
            <select id="res-guests" name="guests" required>
              <option value="" disabled selected>Select</option>
              {Array.from({length: 20}, (_, i) => i + 1).map(num => (
                <option value={num}>{num} {num === 1 ? 'Guest' : 'Guests'}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label for="res-occasion">Occasion</label>
            <select id="res-occasion" name="occasion" required>
              <option value="None">None</option>
              <option value="Birthday">Birthday</option>
              <option value="Anniversary">Anniversary</option>
              <option value="Date Night">Date Night</option>
              <option value="Corporate">Corporate</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary submit-btn">
            Continue to WhatsApp
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="whatsapp-icon">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(14, 11, 10, 0.85); /* --ink */
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .modal-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-container {
    position: relative;
    width: 90%;
    max-width: 500px;
    background-color: var(--soot, #1A1412);
    border: 1px solid rgba(243, 230, 208, 0.1); /* --cream */
    padding: 2.5rem;
    transform: translateY(20px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-backdrop.is-open .modal-container {
    transform: translateY(0);
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: none;
    color: var(--cream, #F3E6D0);
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.3s ease;
    padding: 0.5rem;
    z-index: 10;
  }

  .modal-close:hover {
    opacity: 1;
  }

  .modal-title {
    font-family: var(--font-display, 'Fraunces', serif);
    font-size: 2rem;
    color: var(--neon, #FF2E4D);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .modal-desc {
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.9rem;
    color: var(--cream, #F3E6D0);
    opacity: 0.8;
    text-align: center;
    margin-bottom: 2rem;
  }

  .reserve-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-family: var(--font-neon, 'Josefin Sans', sans-serif);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cream, #F3E6D0);
  }

  .form-group input,
  .form-group select {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(243, 230, 208, 0.2);
    color: white;
    padding: 0.75rem 1rem;
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.3s ease;
    border-radius: 0;
  }

  .form-group input:focus,
  .form-group select:focus {
    border-color: var(--neon, #FF2E4D);
  }
  
  .form-group select option {
    background-color: var(--soot, #1A1412);
    color: white;
  }

  .submit-btn {
    width: 100%;
    margin-top: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--neon, #FF2E4D);
    color: white;
    border: none;
    padding: 1rem;
    font-family: var(--font-neon, 'Josefin Sans', sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .submit-btn:hover {
    background-color: var(--lacquer, #B71C2B);
  }
</style>

<script define:vars={{ SITE }}>
  const initModal = () => {
    const modal = document.getElementById('reserve-modal');
    const form = document.getElementById('reserve-form');
    const closeBtn = modal?.querySelector('.modal-close');
    const triggers = document.querySelectorAll('[data-modal-trigger="reserve-modal"]');
    
    if (!modal || !form) return;

    const openModal = () => {
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      // Basic focus trap setup
      setTimeout(() => {
        const input = form.querySelector('input');
        if (input) input.focus();
      }, 100);
    };

    const closeModal = () => {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    };

    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const name = formData.get('name');
      const phone = formData.get('phone');
      const date = formData.get('date');
      const time = formData.get('time');
      const guests = formData.get('guests');
      const occasion = formData.get('occasion');

      // Add simple confirmation
      if (confirm('Continue to WhatsApp to finalize your reservation?')) {
        const message = `Hi! I'd like to reserve a table at HakkaLand.\n\nName: ${name}\nDate: ${date}\nTime: ${time}\nGuests: ${guests}\nOccasion: ${occasion}`;
        const whatsappUrl = `https://wa.me/${SITE.phone}?text=${encodeURIComponent(message)}`;
        
        window.open(whatsappUrl, '_blank');
        closeModal();
        form.reset();
      }
    });
  };

  // Run on load and after Astro transitions
  document.addEventListener('DOMContentLoaded', initModal);
  document.addEventListener('astro:page-load', initModal);
</script>

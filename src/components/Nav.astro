---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site';

interface Props { base?: string }
const { base = '' } = Astro.props;

const links = [
  { href: `${base}#menu`, label: 'Menu' },
  { href: `${base}#signatures`, label: 'Signatures' },
  { href: `${base}#bar`, label: 'Bar' },
  { href: `${base}#gallery`, label: 'Gallery' },
  { href: `${base}#visit`, label: 'Visit' },
];
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <Logo />
    <nav class="nav-links" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="nav-phone" href={`tel:+${SITE.phoneClean}`}><Icon name="phone" />{SITE.phone}</a>
      <button class="btn btn--primary btn--sm nav-reserve" data-reserve>Reserve</button>
      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer" data-nav-toggle>
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div class="drawer" id="nav-drawer" hidden data-drawer>
    <nav class="container drawer-links" aria-label="Mobile">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={`tel:+${SITE.phoneClean}`} class="drawer-phone"><Icon name="phone" /> {SITE.phone}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    transition: background-color 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
  }
  .nav.is-solid, .nav.is-open {
    background: rgba(20, 16, 14, 0.88);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: var(--line);
  }
  .nav-inner { height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .nav-links { display: flex; gap: 32px; }
  .nav-links a { font-size: 0.9rem; font-weight: 600; color: var(--muted); transition: color 0.2s; }
  .nav-links a:hover { color: var(--text); }
  .nav-actions { display: flex; align-items: center; gap: 16px; }
  .nav-phone { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; font-weight: 600; color: var(--muted); }
  .nav-phone:hover { color: var(--text); }
  .nav-phone :global(svg) { width: 16px; height: 16px; }
  .nav-toggle { display: none; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--line-strong); background: transparent; place-items: center; }
  .nav-toggle :global(svg) { width: 22px; height: 22px; }

  .drawer { border-top: 1px solid var(--line); background: rgba(20, 16, 14, 0.97); }
  .drawer-links { display: grid; padding-block: 12px 24px; }
  .drawer-links a { padding: 14px 0; font-family: var(--font-display); font-size: 1.5rem; border-bottom: 1px solid var(--line); }
  .drawer-links .drawer-phone { display: flex; align-items: center; gap: 10px; font-family: var(--font-body); font-size: 1rem; font-weight: 700; color: var(--amber); border: 0; }
  .drawer-phone :global(svg) { width: 18px; height: 18px; }

  @media (max-width: 1080px) { .nav-phone { display: none; } }
  @media (max-width: 860px) {
    .nav-links { display: none; }
    .nav-toggle { display: grid; }
  }
  @media (min-width: 861px) { .drawer { display: none; } }
  @media (max-width: 767px) { .nav-reserve { display: none; } } /* the mobile action bar has it */
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  const drawer = nav.querySelector<HTMLElement>('[data-drawer]')!;

  const onScroll = () => nav.classList.toggle('is-solid', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    drawer.hidden = !open;
    nav.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  toggle.addEventListener('click', () => setOpen(drawer.hidden));
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>

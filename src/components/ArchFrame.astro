---
export interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
}

const { class: className = '', width = '100%', height = '100%' } = Astro.props;
const uniqueId = `arch-clip-${Math.random().toString(36).substring(2, 9)}`;
---

<div class={`arch-frame-container ${className}`} style={`--width: ${width}; --height: ${height};`}>
  <svg class="sr-only arch-defs">
    <defs>
      <clipPath id={uniqueId} clipPathUnits="objectBoundingBox">
        <path d="M0,1 L1,1 L1,0.3 C1,0.1 0.8,0 0.5,0 C0.2,0 0,0.1 0,0.3 Z" />
      </clipPath>
    </defs>
  </svg>

  <div class="arch-content-wrapper" style={`clip-path: url(#${uniqueId}); -webkit-clip-path: url(#${uniqueId});`}>
    <slot />
  </div>

  <svg class="arch-outline" preserveAspectRatio="none" viewBox="0 0 100 100">
    <path class="ember-line" d="M0,100 L100,100 L100,30 C100,10 80,0 50,0 C20,0 0,10 0,30 Z" vector-effect="non-scaling-stroke" />
  </svg>
</div>

<style>
  .arch-frame-container {
    position: relative;
    width: var(--width);
    height: var(--height);
    overflow: visible;
  }
  
  .arch-defs {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .arch-content-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .arch-outline {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  .ember-line {
    fill: none;
    stroke: var(--ember, #FF8A3D);
    stroke-width: 2px;
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    opacity: 0.8;
  }
  
  .arch-frame-container.glow .ember-line {
    filter: drop-shadow(0 0 8px var(--ember, #FF8A3D));
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initArchFrames = () => {
    const frames = document.querySelectorAll('.arch-frame-container');
    
    frames.forEach((frame) => {
      const line = frame.querySelector('.ember-line');
      
      if (!line) return;
      
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: frame,
          start: 'top 80%',
          once: true
        }
      });
      
      tl.to(line, {
        strokeDashoffset: 0,
        duration: 1.5,
        ease: 'power3.out'
      }).add(() => {
        frame.classList.add('glow');
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initArchFrames);
  // Also run on Astro page load
  document.addEventListener('astro:page-load', initArchFrames);
</script>

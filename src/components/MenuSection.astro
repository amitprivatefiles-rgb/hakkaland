---
import Icon from './Icon.astro';
import VegMark from './VegMark.astro';
import DietMarks from './DietMarks.astro';
import { MENU, rupee, isVeg, hasVeg, hasNonVeg } from '../lib/menu';

const initial = MENU[0].slug;
---

<section class="section" id="menu" aria-labelledby="menu-title">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">The menu</p>
        <h2 class="h2" id="menu-title">Steamers, woks &amp; <em>sizzlers</em></h2>
        <p class="lead">Prices in rupees, exclusive of taxes. Ask your server about spice levels and allergens.</p>
      </div>
      <a class="link-arrow" href="/menu">Printable menu <Icon name="arrow" /></a>
    </div>

    <div class="menu" data-menu>
      <div class="menu-tools">
        <label class="search">
          <Icon name="search" />
          <span class="sr-only">Search the menu</span>
          <input type="search" placeholder="Search dishes…" autocomplete="off" data-search />
        </label>
        <label class="veg-toggle">
          <input type="checkbox" data-veg />
          <span class="switch" aria-hidden="true"></span>
          <span><VegMark veg={true} /> Veg only</span>
        </label>
      </div>

      <div class="tabs" role="tablist" aria-label="Menu categories" data-tabs>
        {MENU.map((c) => (
          <button
            role="tab"
            id={`tab-${c.slug}`}
            aria-controls={`panel-${c.slug}`}
            aria-selected={c.slug === initial ? 'true' : 'false'}
            tabindex={c.slug === initial ? 0 : -1}
            data-tab={c.slug}
          >{c.category}</button>
        ))}
      </div>

      <div class="panels">
        {MENU.map((c) => (
          <div class="panel" role="tabpanel" id={`panel-${c.slug}`} aria-labelledby={`tab-${c.slug}`} data-panel={c.slug} hidden={c.slug !== initial}>
            <div class="panel-head">
              <h3>{c.category}</h3>
              {c.note && <p>{c.note}</p>}
            </div>
            <ul class="items">
              {c.items.map((item) => (
                <li class="item" data-item data-name={[item.name, item.desc, ...item.variants.map((v) => v.label)].filter(Boolean).join(' ').toLowerCase()} data-veg={isVeg(item) ? 'all' : item.variants.some((v) => v.veg) ? 'some' : 'none'}>
                  <div class="item-top">
                    <h4>
                      <DietMarks veg={hasVeg(item)} nonveg={hasNonVeg(item)} />
                      <span>{item.name}</span>
                      {item.bestSeller && <span class="tag">Best seller</span>}
                    </h4>
                    {item.variants.length === 1 && <span class="item-price">{rupee(item.variants[0].price)}</span>}
                  </div>
                  {item.desc && <p class="item-desc">{item.desc}</p>}
                  {item.variants.length > 1 && (
                    <ul class="variants">
                      {item.variants.map((v) => (
                        <li data-variant-veg={String(v.veg)}>
                          <span>{v.label}</span>
                          <strong>{rupee(v.price)}</strong>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p class="empty" hidden data-empty>Nothing here matches your filters. Try another category, or search for “prawn”, “noodles” or “paneer”.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .menu {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: clamp(20px, 3vw, 40px);
  }
  .menu-tools { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .search {
    position: relative; flex: 1 1 280px; max-width: 420px;
    display: flex; align-items: center;
  }
  .search :global(svg) { position: absolute; left: 16px; width: 18px; height: 18px; color: var(--muted); pointer-events: none; }
  .search input {
    width: 100%; height: 48px; padding: 0 16px 0 46px;
    background: var(--bg); border: 1px solid var(--line-strong); border-radius: 999px; outline: none;
  }
  .search input:focus { border-color: var(--amber); }
  .search input::placeholder { color: #8a7b6e; }

  .veg-toggle { display: inline-flex; align-items: center; gap: 12px; font-weight: 600; font-size: 0.95rem; cursor: pointer; user-select: none; }
  .veg-toggle > span:last-child { display: inline-flex; align-items: center; gap: 8px; }
  .veg-toggle input { position: absolute; opacity: 0; pointer-events: none; }
  .switch { position: relative; width: 44px; height: 26px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line-strong); transition: background-color 0.2s; }
  .switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: var(--muted); transition: transform 0.2s, background-color 0.2s; }
  .veg-toggle input:checked + .switch { background: rgba(58, 163, 87, 0.3); border-color: var(--veg); }
  .veg-toggle input:checked + .switch::after { transform: translateX(18px); background: var(--veg); }
  .veg-toggle input:focus-visible + .switch { outline: 2px solid var(--amber); outline-offset: 3px; }

  .tabs {
    display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none;
    padding-bottom: 20px; margin-bottom: 8px; border-bottom: 1px solid var(--line);
    mask-image: linear-gradient(90deg, #000 92%, transparent);
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs button {
    flex: none; height: 40px; padding: 0 16px; border-radius: 999px;
    background: transparent; border: 1px solid var(--line-strong); color: var(--muted);
    font-size: 0.875rem; font-weight: 600; white-space: nowrap;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .tabs button:hover { color: var(--text); border-color: var(--text); }
  .tabs button[aria-selected='true'] { background: var(--text); border-color: var(--text); color: var(--bg); }
  .menu.is-searching .tabs { opacity: 0.4; pointer-events: none; }

  .panel { padding-top: 24px; }
  .panel + .panel { margin-top: 16px; }
  .panel-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; margin-bottom: 8px; }
  .panel-head h3 { font-size: 1.6rem; }
  .panel-head p { color: var(--muted); font-size: 0.9rem; font-style: italic; }

  .items { display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(24px, 4vw, 64px); }
  .item { padding: 18px 0; border-bottom: 1px dashed var(--line-strong); }
  .item-top { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .item h4 { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; font-family: var(--font-body); font-size: 1.02rem; font-weight: 700; letter-spacing: 0; line-height: 1.35; }
  .item h4 :global(.vm) { margin-top: 1px; }
  .item-price { font-weight: 800; white-space: nowrap; }
  .item-desc { margin-top: 4px; color: var(--muted); font-size: 0.9rem; padding-left: 24px; }
  .variants { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; padding-left: 24px; }
  .variants li {
    display: inline-flex; gap: 8px; align-items: baseline;
    padding: 4px 12px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line);
    font-size: 0.84rem; color: var(--muted);
  }
  .variants strong { color: var(--text); font-weight: 700; }
  .empty { padding: 40px 0; text-align: center; color: var(--muted); }

  @media (max-width: 760px) {
    .items { grid-template-columns: 1fr; }
    .search { max-width: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-menu]')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
  const search = root.querySelector<HTMLInputElement>('[data-search]')!;
  const vegOnly = root.querySelector<HTMLInputElement>('[data-veg]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  let active = tabs.find((t) => t.getAttribute('aria-selected') === 'true')!.dataset.tab!;
  // Centre the initially selected tab without scrolling the page.
  const tabList = root.querySelector<HTMLElement>('[data-tabs]')!;
  const first = tabs.find((t) => t.dataset.tab === active)!;
  tabList.scrollLeft = first.offsetLeft - tabList.clientWidth / 2 + first.clientWidth / 2;

  const select = (slug: string, focus = false) => {
    active = slug;
    tabs.forEach((t) => {
      const on = t.dataset.tab === slug;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on) {
        t.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
        if (focus) t.focus();
      }
    });
    apply();
  };

  const apply = () => {
    const q = search.value.trim().toLowerCase();
    const veg = vegOnly.checked;
    root.classList.toggle('is-searching', !!q);
    let anyVisible = false;

    panels.forEach((p) => {
      let count = 0;
      p.querySelectorAll<HTMLElement>('[data-item]').forEach((item) => {
        const matchQ = !q || item.dataset.name!.includes(q);
        const matchVeg = !veg || item.dataset.veg !== 'none';
        const show = matchQ && matchVeg;
        item.hidden = !show;
        item.querySelectorAll<HTMLElement>('[data-variant-veg]').forEach((v) => {
          v.hidden = veg && v.dataset.variantVeg === 'false';
        });
        if (show) count++;
      });
      const visible = (q ? true : p.dataset.panel === active) && count > 0;
      p.hidden = !visible;
      if (visible) anyVisible = true;
    });
    empty.hidden = anyVisible;
  };

  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true);
    });
  });
  search.addEventListener('input', apply);
  vegOnly.addEventListener('change', apply);
</script>

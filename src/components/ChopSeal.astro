---
export interface Props {
  text?: string;
  class?: string;
}

const { text = 'BEST SELLER', class: className = '' } = Astro.props;
---

<div class={`chop-seal-wrapper ${className}`}>
  <div class="chop-seal">
    <span class="chop-text">{text}</span>
  </div>
</div>

<style>
  .chop-seal-wrapper {
    display: inline-block;
    perspective: 500px;
  }

  .chop-seal {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 60px;
    height: 60px;
    background-color: var(--neon, #FF2E4D);
    color: white;
    border: 2px solid white;
    border-radius: 4px;
    box-shadow: 0 0 0 2px var(--neon, #FF2E4D), 0 4px 10px rgba(255, 46, 77, 0.3);
    /* Subtle roughness */
    mask-image: url("data:image/svg+xml,%3Csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='rough'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.5' numOctaves='3' result='noise'/%3E%3CfeDisplacementMap in='SourceGraphic' in2='noise' scale='2' xChannelSelector='R' yChannelSelector='G'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23rough)'/%3E%3C/svg%3E");
    mask-type: luminance;
    -webkit-mask-image: url("data:image/svg+xml,%3Csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='rough'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.5' numOctaves='3' result='noise'/%3E%3CfeDisplacementMap in='SourceGraphic' in2='noise' scale='2' xChannelSelector='R' yChannelSelector='G'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23rough)' fill='white'/%3E%3C/svg%3E");
    transform: scale(0) rotate(0deg);
    opacity: 0;
  }

  .chop-text {
    font-family: var(--font-neon, 'Josefin Sans', sans-serif);
    font-weight: 700;
    font-size: 10px;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 1px;
    word-break: break-word;
    padding: 4px;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initChopSeals = () => {
    const seals = document.querySelectorAll('.chop-seal');
    
    seals.forEach((seal) => {
      gsap.fromTo(seal, 
        {
          scale: 1.8,
          rotation: -25,
          opacity: 0
        },
        {
          scale: 1,
          rotation: -12,
          opacity: 1,
          duration: 0.8,
          ease: 'back.out(2)',
          scrollTrigger: {
            trigger: seal,
            start: 'top 85%',
            once: true
          }
        }
      );
    });
  };

  document.addEventListener('DOMContentLoaded', initChopSeals);
  document.addEventListener('astro:page-load', initChopSeals);
</script>

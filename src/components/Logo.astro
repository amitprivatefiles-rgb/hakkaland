---
import { Image } from 'astro:assets';
import logo from '../assets/brand/hakkaland-logo.png';

interface Props { href?: string; class?: string }
const { href = '/', class: cls } = Astro.props;
---
<a href={href} class:list={['logo', cls]}>
  <Image src={logo} alt="HakkaLand" loading="eager" />
</a>

<style>
  .logo { display: inline-flex; align-items: center; }
  .logo img { display: block; width: auto; height: var(--logo-h, 30px); }
</style>

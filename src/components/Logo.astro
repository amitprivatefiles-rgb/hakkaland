---
interface Props { href?: string; class?: string }
const { href = '/', class: cls } = Astro.props;
---
<a href={href} class:list={['logo', cls]} aria-label="HakkaLand home">
  <span class="logo-hakka">Hakka</span><span class="logo-land">Land</span>
</a>

<style>
  .logo {
    display: inline-flex; align-items: baseline;
    font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; letter-spacing: -0.02em; line-height: 1;
  }
  .logo-hakka { color: var(--text); }
  .logo-land {
    color: var(--neon);
    font-style: italic; font-weight: 600;
    text-shadow: 0 0 12px rgba(255, 59, 92, 0.55), 0 0 28px rgba(255, 59, 92, 0.3);
  }
</style>

---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import DietMarks from './DietMarks.astro';
import bao from '../assets/img/bao-oyster-bbq.webp';
import sate from '../assets/img/sate-hibachi.webp';
import crispy from '../assets/img/crispy-chicken-plate.webp';
import sizzler from '../assets/img/glazed-sizzler-chicken.webp';
import noodles from '../assets/img/noodles-chilli-chicken.webp';
import brownie from '../assets/img/sizzling-brownie.webp';

const dishes = [
  { img: sate, name: 'BBQ Satay', cat: 'World of satay', desc: 'Paneer or chicken skewers, grilled over a tabletop charcoal hibachi.', price: 'from ₹369', veg: 'both' },
  { img: sizzler, name: 'BBQ Sizzler', cat: 'Sizzlers', desc: 'Chicken, basa, vetki or prawn, served hissing on a cast-iron plate.', price: 'from ₹499', veg: false },
  { img: bao, name: 'Bao', cat: 'Momo & bao', desc: 'Pillowy steamed buns with paneer or chicken.', price: '₹269', veg: 'both' },
  { img: crispy, name: 'Crispy Chicken', cat: 'Starters', desc: 'Golden, crunchy and tossed hot from the wok.', price: '₹399', veg: false },
  { img: noodles, name: 'Pan Fried Noodles', cat: 'Gravy noodles', desc: 'Crisp-edged noodles under a glossy, saucy stir-fry.', price: 'from ₹249', veg: 'both' },
  { img: brownie, name: 'Brownie with Ice Cream', cat: 'Dessert', desc: 'Warm brownie topped with a scoop of ice cream.', price: '₹299', veg: true },
];
---

<section class="section section--alt" id="signatures" aria-labelledby="sig-title">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Signatures</p>
        <h2 class="h2" id="sig-title">What everyone <em>orders</em></h2>
        <p class="lead">The plates that keep regulars coming back — from charcoal satay to cast-iron sizzlers.</p>
      </div>
      <a class="link-arrow" href="#menu">See the full menu <Icon name="arrow" /></a>
    </div>

    <ul class="dish-grid">
      {dishes.map((d) => (
        <li class="dish reveal">
          <div class="dish-img">
            <Image src={d.img} alt={d.name} widths={[400, 640]} sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 380px" />
          </div>
          <div class="dish-body">
            <p class="dish-cat">{d.cat}</p>
            <div class="dish-row">
              <h3><DietMarks veg={d.veg !== false} nonveg={d.veg !== true} /> {d.name}</h3>
              <span class="dish-price">{d.price}</span>
            </div>
            <p class="dish-desc">{d.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .dish-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.4vw, 32px); }
  .dish {
    display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden;
    transition: transform 0.35s, border-color 0.35s;
  }
  .dish:hover { transform: translateY(-4px); border-color: var(--line-strong); }
  .dish-img { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .dish-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
  .dish:hover .dish-img img { transform: scale(1.05); }
  .dish-body { padding: 20px 22px 24px; }
  .dish-cat { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--amber); margin-bottom: 8px; }
  .dish-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .dish h3 { display: flex; align-items: center; gap: 10px; font-size: 1.3rem; }
  .dish-price { font-weight: 800; white-space: nowrap; }
  .dish-desc { margin-top: 8px; color: var(--muted); font-size: 0.93rem; }

  @media (max-width: 1024px) { .dish-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .dish-grid { grid-template-columns: 1fr; } }
</style>

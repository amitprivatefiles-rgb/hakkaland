---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import booths from '../assets/img/booths-arches-wide.webp';
import tileTable from '../assets/img/tile-table-night.webp';

const features = [
  { icon: 'arch', title: 'Brick arches & booths', text: 'Tufted leather booths under warm LED-lit arches, on hand-patterned Peranakan tiles.' },
  { icon: 'glass', title: 'A full bar', text: 'Mocktails, pitchers, beer and cocktails — from the backlit bar at the far end of the room.' },
  { icon: 'cake', title: 'Made for celebrations', text: 'Birthdays, anniversaries and office dinners. Big tables are easy to arrange.' },
] as const;
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="about-copy reveal">
      <p class="eyebrow">The space</p>
      <h2 class="h2" id="about-title">A little corner of Asia on <em>Jessore Road</em></h2>
      <p class="lead">
        Step out of the lift on Star Mall's fifth floor and the city falls away. Amber light traces every arch, the neon sign hums over the bar,
        and the kitchen sends out steamers, sizzlers and wok-tossed noodles.
      </p>

      <ul class="features">
        {features.map((f) => (
          <li>
            <span class="feature-icon"><Icon name={f.icon} /></span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="about-media reveal">
      <figure class="media-main">
        <Image src={booths} alt="Leather booths beneath illuminated brick arches" widths={[480, 720]} sizes="(max-width: 900px) 90vw, 520px" />
      </figure>
      <figure class="media-sub">
        <Image src={tileTable} alt="A patterned tile table lit by a pendant lamp" widths={[320, 520]} sizes="(max-width: 900px) 45vw, 260px" />
      </figure>
      <div class="media-badge">
        <strong>5th</strong>
        <span>floor<br />Star Mall</span>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }

  .features { display: grid; gap: 24px; margin-top: 40px; }
  .features li { display: grid; grid-template-columns: 48px 1fr; gap: 16px; align-items: start; }
  .feature-icon {
    width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center;
    background: var(--surface); border: 1px solid var(--line); color: var(--amber);
  }
  .feature-icon :global(svg) { width: 22px; height: 22px; }
  .features h3 { font-family: var(--font-body); font-size: 1rem; font-weight: 700; letter-spacing: 0; margin-bottom: 4px; }
  .features p { color: var(--muted); font-size: 0.95rem; }

  .about-media { position: relative; padding: 0 0 18% 0; }
  .about-media figure { margin: 0; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .about-media img { width: 100%; height: 100%; object-fit: cover; }
  .media-main { width: 88%; aspect-ratio: 4 / 4.4; }
  .media-sub {
    position: absolute; right: 0; bottom: 0; width: 46%; aspect-ratio: 3 / 4;
    border: 6px solid var(--bg);
  }
  .media-badge {
    position: absolute; left: 6%; bottom: 6%;
    display: flex; align-items: center; gap: 10px;
    padding: 14px 18px; border-radius: 16px;
    background: rgba(20, 16, 14, 0.85); backdrop-filter: blur(8px); border: 1px solid var(--line-strong);
  }
  .media-badge strong { font-family: var(--font-display); font-size: 2.2rem; line-height: 1; color: var(--amber); }
  .media-badge span { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.3; color: var(--muted); }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-media { max-width: 560px; }
  }
</style>

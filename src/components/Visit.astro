---
import Icon from './Icon.astro';
import { SITE, wa } from '../config/site';
---

<section class="section section--alt" id="visit" aria-labelledby="visit-title">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Visit us</p>
        <h2 class="h2" id="visit-title">Find us on the <em>fifth floor</em></h2>
        <p class="lead">Take the lift to the top of Star Mall on Jessore Road — follow the neon.</p>
      </div>
    </div>

    <div class="visit-grid">
      <div class="info reveal">
        <ul class="info-list">
          <li>
            <span class="ii"><Icon name="pin" /></span>
            <div>
              <h3>Address</h3>
              <p>{SITE.address.line1}<br />{SITE.address.line2}<br />{SITE.address.line3} {SITE.address.pin}</p>
            </div>
          </li>
          <li>
            <span class="ii"><Icon name="clock" /></span>
            <div><h3>Hours</h3><p>{SITE.hours}</p></div>
          </li>
          <li>
            <span class="ii"><Icon name="phone" /></span>
            <div><h3>Reservations</h3><p><a href={`tel:+${SITE.phoneClean}`}>{SITE.phone}</a></p></div>
          </li>
          <li>
            <span class="ii"><Icon name="wallet" /></span>
            <div><h3>Cost for two</h3><p>Approx. {SITE.costForTwo} · {SITE.cuisines.join(', ')}</p></div>
          </li>
        </ul>

        <div class="ratings">
          {SITE.ratings.map((r) => (
            <div class="rating">
              <strong>{r.score}<span>/5</span></strong>
              <span>{r.label}<br />{r.count}+ ratings</span>
            </div>
          ))}
        </div>

        <div class="info-ctas">
          <a class="btn btn--primary" href={SITE.directionsUrl} target="_blank" rel="noopener"><Icon name="pin" /> Get directions</a>
          <a class="btn btn--ghost" href={wa('Hi HakkaLand! I have a question.')} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
        </div>
      </div>

      <div class="map reveal">
        <iframe
          src={SITE.mapEmbedUrl}
          title="Map showing HakkaLand at Star Mall, Madhyamgram"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .visit-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(20px, 3vw, 32px); align-items: stretch; }
  .info {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 40px);
    display: flex; flex-direction: column; gap: 28px;
  }
  .info-list { display: grid; gap: 22px; }
  .info-list li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; }
  .ii { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--bg); border: 1px solid var(--line); color: var(--amber); }
  .ii :global(svg) { width: 20px; height: 20px; }
  .info h3 { font-family: var(--font-body); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .info p { font-weight: 600; }
  .info a:hover { color: var(--amber); }

  .ratings { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .rating { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: var(--radius); background: var(--bg); border: 1px solid var(--line); }
  .rating strong { font-family: var(--font-display); font-size: 2rem; line-height: 1; color: var(--amber); }
  .rating strong span { font-size: 0.9rem; color: var(--muted); }
  .rating > span { font-size: 0.78rem; line-height: 1.35; color: var(--muted); font-weight: 600; }

  .info-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: auto; }

  .map { min-height: 420px; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); background: var(--surface); }
  .map iframe { width: 100%; height: 100%; min-height: 420px; border: 0; filter: grayscale(0.3) contrast(1.05); }

  @media (max-width: 900px) { .visit-grid { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .ratings { grid-template-columns: 1fr; } .info-ctas .btn { flex: 1 1 100%; } }
</style>

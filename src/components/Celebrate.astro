---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import guests from '../assets/img/booths-arches-guests.webp';
import { wa } from '../config/site';

const points = ['Birthdays & anniversaries', 'Office lunches & team dinners', 'Large group seating', 'Set menus on request'];
---

<section class="section celebrate" aria-labelledby="cel-title">
  <div class="container">
    <div class="cel-card reveal">
      <Image src={guests} alt="Guests dining in booths under the brick arches" class="cel-img" widths={[640, 960]} sizes="(max-width: 900px) 100vw, 1200px" />
      <div class="cel-shade" aria-hidden="true"></div>
      <div class="cel-content">
        <p class="eyebrow">Celebrations &amp; groups</p>
        <h2 class="h2" id="cel-title">Got a reason to <em>celebrate?</em></h2>
        <p class="lead">Tell us the date, the headcount and the occasion — we'll set up the booths, sort the menu and have the sizzlers ready.</p>
        <ul class="cel-points">
          {points.map((p) => <li>{p}</li>)}
        </ul>
        <div class="cel-ctas">
          <a class="btn btn--primary" href={wa("Hi HakkaLand! I'd like to plan a celebration / group booking.")} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Plan on WhatsApp
          </a>
          <button class="btn btn--ghost" data-reserve><Icon name="calendar" /> Reserve a table</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cel-card {
    position: relative; isolation: isolate; overflow: hidden;
    border-radius: clamp(18px, 2.5vw, 28px); border: 1px solid var(--line);
    min-height: 520px; display: flex; align-items: center;
    padding: clamp(28px, 5vw, 72px);
  }
  .cel-img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .cel-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(20, 16, 14, 0.95) 0%, rgba(20, 16, 14, 0.8) 45%, rgba(20, 16, 14, 0.2) 100%); }
  .cel-content { max-width: 560px; }
  .cel-points { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; margin-top: 28px; }
  .cel-points li { position: relative; padding-left: 22px; font-weight: 600; font-size: 0.95rem; }
  .cel-points li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--neon); }
  .cel-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  @media (max-width: 640px) {
    .cel-shade { background: linear-gradient(0deg, rgba(20, 16, 14, 0.96) 35%, rgba(20, 16, 14, 0.55) 100%); }
    .cel-card { align-items: flex-end; min-height: 600px; }
    .cel-points { grid-template-columns: 1fr; }
    .cel-ctas .btn { flex: 1 1 100%; }
  }
</style>

---
const SITE = {
  phone: '+1 (555) 123-4567',
  cleanPhone: '15551234567',
  mapsLink: 'https://maps.google.com/?q=123+Main+Street+Hakka+Town+NY'
};
---

<div class="mobile-action-bar mobile-only">
  <a href={`tel:${SITE.cleanPhone}`} class="action-btn" aria-label="Call Us">
    <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    <span>Call</span>
  </a>

  <a href={`https://wa.me/${SITE.cleanPhone}`} target="_blank" rel="noopener noreferrer" class="action-btn" aria-label="WhatsApp Us">
    <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <span>WhatsApp</span>
  </a>

  <a href={SITE.mapsLink} target="_blank" rel="noopener noreferrer" class="action-btn" aria-label="Get Directions">
    <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
    </svg>
    <span>Directions</span>
  </a>
</div>

<style>
  .mobile-action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 60px;
    background-color: rgba(26, 20, 18, 0.85); /* --soot */
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: var(--z-sticky, 100);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: var(--cream, #F3E6D0);
    text-decoration: none;
    flex: 1;
    height: 100%;
  }

  .action-icon {
    width: 20px;
    height: 20px;
  }

  .action-btn span {
    font-family: var(--font-neon, 'Josefin Sans', sans-serif);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mobile-only {
    display: flex;
  }

  @media (min-width: 768px) {
    .mobile-only {
      display: none;
    }
  }
</style>

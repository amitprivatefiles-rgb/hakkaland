---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import storefront from '../assets/img/storefront-day.webp';
import wokSpread from '../assets/img/wok-spread-skillets.webp';
import dayLattice from '../assets/img/day-lattice-balloons.webp';
import nasi from '../assets/img/nasi-goreng-banana-leaf.webp';
import cheers from '../assets/img/drinks-cheers.webp';
import arch from '../assets/img/arch-column-moody.webp';
import skewers from '../assets/img/grilled-herb-skewers.webp';
import redMocktail from '../assets/img/neon-red-mocktail.webp';
import dayHall from '../assets/img/day-long-hall.webp';
import crispy from '../assets/img/crispy-chicken-plate.webp';
import neonNoodles from '../assets/img/noodles-neon-bowl.webp';
import dimsum2 from '../assets/img/dimsum-steamer-2.webp';
import blueChairs from '../assets/img/day-glass-blue-chairs.webp';
import fish from '../assets/img/crumb-fried-fish.webp';
import sateGreen from '../assets/img/sate-hibachi-green.webp';
import margarita from '../assets/img/drinks-margarita-icedtea.webp';

const photos = [
  { src: storefront, alt: 'The HakkaLand entrance and neon sign in daylight' },
  { src: wokSpread, alt: 'A spread of wok dishes in cast-iron skillets' },
  { src: cheers, alt: 'Friends raising mason-jar drinks' },
  { src: nasi, alt: 'Nasi goreng with a fried egg on banana leaf' },
  { src: arch, alt: 'A brick column glowing under amber light' },
  { src: redMocktail, alt: 'A red mocktail beneath the neon sign' },
  { src: dayLattice, alt: 'The lattice dining area with balloons by day' },
  { src: skewers, alt: 'Herb-marinated grilled skewers' },
  { src: dayHall, alt: 'The long dining hall with blue chairs by day' },
  { src: crispy, alt: 'Crispy chicken served on a patterned plate' },
  { src: neonNoodles, alt: 'A bowl of noodles under the neon sign' },
  { src: dimsum2, alt: 'Dim sum in a bamboo steamer' },
  { src: sateGreen, alt: 'Green herb saté on a tabletop hibachi' },
  { src: blueChairs, alt: 'Glass-walled dining area with cobalt chairs' },
  { src: fish, alt: 'Crumb-fried fish with dip on a tiled table' },
  { src: margarita, alt: 'A margarita and iced tea under the arches' },
];

const full = await Promise.all(photos.map((p) => getImage({ src: p.src, width: 1360, format: 'webp' })));
---

<section class="section" id="gallery" aria-labelledby="gal-title">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">Gallery</p>
        <h2 class="h2" id="gal-title">Day to <em>night</em></h2>
        <p class="lead">Sunlit lunches by the glass walls, neon-lit dinners under the arches.</p>
      </div>
    </div>

    <ul class="masonry">
      {photos.map((p, i) => (
        <li class="reveal">
          <button class="shot" data-full={full[i].src} data-alt={p.alt} aria-label={`Open photo: ${p.alt}`}>
            <Image src={p.src} alt={p.alt} widths={[360, 560]} sizes="(max-width: 640px) 46vw, (max-width: 1024px) 31vw, 290px" />
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
    <button class="lb-btn lb-close" aria-label="Close" data-lb-close><Icon name="close" /></button>
    <button class="lb-btn lb-prev" aria-label="Previous photo" data-lb-prev><Icon name="chevL" /></button>
    <figure>
      <img alt="" data-lb-img />
      <figcaption data-lb-cap></figcaption>
    </figure>
    <button class="lb-btn lb-next" aria-label="Next photo" data-lb-next><Icon name="chevR" /></button>
  </dialog>
</section>

<style>
  .masonry { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .shot { display: block; width: 100%; aspect-ratio: 4 / 5; padding: 0; border: 0; background: var(--surface); border-radius: var(--radius); overflow: hidden; cursor: zoom-in; }
  .shot img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s, filter 0.4s; }
  .shot:hover img { transform: scale(1.04); filter: brightness(1.08); }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgba(10, 8, 7, 0.96); color: var(--text);
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgba(0, 0, 0, 0.6); }
  .lightbox figure { margin: 0; display: grid; gap: 14px; justify-items: center; padding: 64px 16px; }
  .lightbox img { max-width: min(92vw, 1200px); max-height: calc(100dvh - 160px); width: auto; height: auto; border-radius: 12px; }
  .lightbox figcaption { color: var(--muted); font-size: 0.9rem; text-align: center; }
  .lb-btn {
    position: absolute; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(245, 236, 226, 0.08); border: 1px solid var(--line-strong);
  }
  .lb-btn:hover { background: rgba(245, 236, 226, 0.16); }
  .lb-btn :global(svg) { width: 22px; height: 22px; }
  .lb-close { top: 16px; right: 16px; }
  .lb-prev { left: 16px; top: 50%; translate: 0 -50%; }
  .lb-next { right: 16px; top: 50%; translate: 0 -50%; }
  @media (max-width: 1024px) and (min-width: 641px) { .masonry { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) {
    .masonry { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .lb-prev, .lb-next { top: auto; bottom: 16px; translate: none; }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
  const shots = [...document.querySelectorAll<HTMLButtonElement>('#gallery .shot')];
  let idx = 0;

  const show = (i: number) => {
    idx = (i + shots.length) % shots.length;
    img.src = shots[idx].dataset.full!;
    img.alt = shots[idx].dataset.alt!;
    cap.textContent = `${shots[idx].dataset.alt}  ·  ${idx + 1} / ${shots.length}`;
  };

  shots.forEach((s, i) => s.addEventListener('click', () => { show(i); dlg.showModal(); }));
  dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(idx - 1));
  dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(idx + 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
  dlg.addEventListener('close', () => shots[idx]?.focus());
</script>

---
// Preloader.astro
---
<div id="preloader" class="preloader">
  <div class="preloader-content">
    <svg class="wordmark" viewBox="0 0 600 150" xmlns="http://www.w3.org/2000/svg">
      <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" class="wordmark-text">HakkaLand</text>
    </svg>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    background-color: var(--ink, #0E0B0A);
    z-index: var(--z-preloader, 9999);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    overflow: hidden;
  }
  .preloader-content {
    width: 90vw;
    max-width: 800px;
  }
  .wordmark {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .wordmark-text {
    font-family: var(--font-neon, 'Josefin Sans', sans-serif);
    font-size: 100px;
    font-weight: 200;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    fill: transparent;
    stroke: var(--cream, #F3E6D0);
    stroke-width: 1.5px;
    /* Large enough to cover the text perimeter */
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
  }
  /* Applied via GSAP class toggle */
  :global(.neon-buzz) {
    stroke: var(--neon, #FF2E4D);
    fill: transparent; /* Keep transparent or fill slightly */
    filter: drop-shadow(0 0 5px var(--neon)) drop-shadow(0 0 15px var(--neon)) drop-shadow(0 0 30px var(--lacquer, #B71C2B));
    stroke-width: 2px;
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const preloader = document.getElementById('preloader');
    if (!preloader) return;

    // Check if already visited in this session
    if (sessionStorage.getItem('hakkaland-visited')) {
      preloader.style.display = 'none';
      return;
    }

    const text = preloader.querySelector('.wordmark-text');
    
    // Create the timeline
    const tl = gsap.timeline({
      onComplete: () => {
        sessionStorage.setItem('hakkaland-visited', 'true');
        gsap.to(preloader, { 
          opacity: 0, 
          duration: 0.6, 
          ease: 'power3.out', 
          onComplete: () => preloader.style.display = 'none' 
        });
      }
    });

    // 1. Draw the text outline
    tl.to(text, { 
      strokeDashoffset: 0, 
      duration: 1.2, 
      ease: 'power3.inOut' 
    })
    // 2. Flicker and buzz into neon
    .set(text, { className: 'wordmark-text neon-buzz' })
    .to(text, { opacity: 0.3, duration: 0.05, yoyo: true, repeat: 5 })
    .to(text, { opacity: 1, duration: 0.2 });

    // Allow user to skip
    preloader.addEventListener('click', () => {
      tl.progress(1);
    });
  });
</script>

---
import menu from '../../data/menu.json';
---

<section class="interactive-menu" id="menu">
  <div class="fret-corner top-left"></div>
  <div class="fret-corner top-right"></div>
  <div class="fret-corner bottom-left"></div>
  <div class="fret-corner bottom-right"></div>

  <div class="container">
    <p class="eyebrow">THE MENU</p>
    <h2 class="menu-title">Our Menu</h2>

    <div class="menu-filters-wrapper">
      <nav class="category-rail" aria-label="Menu categories">
        <ul class="category-list">
          {menu.map((cat, idx) => (
            <li>
              <button 
                class={`cat-btn ${idx === 0 ? 'active' : ''}`} 
                data-target={`cat-${cat.category.replace(/[^a-zA-Z0-9]/g, '-')}`}
              >
                {cat.category}
              </button>
            </li>
          ))}
        </ul>
      </nav>

      <div class="filters-row">
        <div class="veg-toggle-wrap">
          <label class="filter-label">
            <input type="checkbox" id="veg-filter" value="veg" />
            <span class="veg-dot" aria-hidden="true"></span> Veg Only
          </label>
        </div>
        
        <div class="search-wrap">
          <input type="text" id="menu-search" placeholder="Search menu..." />
        </div>
        
        <div class="bestseller-toggle-wrap">
          <label class="filter-label">
            <input type="checkbox" id="bestseller-filter" />
            <span class="chop-seal"></span> Best Sellers
          </label>
        </div>
      </div>
    </div>

    <div class="menu-content">
      {menu.map((cat) => (
        <div class="menu-category-section" id={`cat-${cat.category.replace(/[^a-zA-Z0-9]/g, '-')}`}>
          <h3 class="category-header">{cat.category}</h3>
          <div class="menu-grid">
            {cat.items.map((item) => (
              <div 
                class="menu-item" 
                data-name={item.name.toLowerCase()} 
                data-type={item.type || 'non-veg'} 
                data-bestseller={item.bestseller ? 'true' : 'false'}
              >
                <div class="item-header">
                  <div class="name-wrap">
                    <span class={item.type === 'veg' ? 'veg-dot' : 'nonveg-dot'}></span>
                    <h4>{item.name}</h4>
                    {item.bestseller && <span class="chop-seal" title="Best Seller">★</span>}
                  </div>
                  {item.price && <div class="price-pill">₹{item.price}</div>}
                </div>
                {item.description && <p class="item-desc">{item.description}</p>}
                {item.variants && (
                  <div class="variants">
                    {item.variants.map((v) => (
                      <span class="price-pill variant">{v.name} ₹{v.price}</span>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="menu-footer">
      <a href="/menu" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Download Menu (PDF)</a>
    </div>
  </div>
</section>

<style>
  .interactive-menu {
    background-color: var(--lacquer, #B71C2B);
    color: var(--cream, #F3E6D0);
    position: relative;
    padding: var(--space-2xl) 0;
    overflow: hidden;
  }

  .fret-corner {
    position: absolute;
    width: 60px;
    height: 60px;
    background: transparent;
    border: 2px solid rgba(243, 230, 208, 0.2);
  }
  .fret-corner.top-left { top: 20px; left: 20px; border-right: none; border-bottom: none; }
  .fret-corner.top-right { top: 20px; right: 20px; border-left: none; border-bottom: none; }
  .fret-corner.bottom-left { bottom: 20px; left: 20px; border-right: none; border-top: none; }
  .fret-corner.bottom-right { bottom: 20px; right: 20px; border-left: none; border-top: none; }

  .eyebrow {
    font-family: var(--font-neon);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.875rem;
    margin-bottom: var(--space-xs);
    opacity: 0.8;
  }

  .menu-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: var(--space-xl);
    color: #fff;
  }

  .menu-filters-wrapper {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--lacquer, #B71C2B);
    padding: var(--space-md) 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    margin-bottom: var(--space-xl);
  }

  .category-rail {
    overflow-x: auto;
    scrollbar-width: none;
    margin-bottom: var(--space-md);
  }
  .category-rail::-webkit-scrollbar { display: none; }

  .category-list {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cat-btn {
    background: none;
    border: none;
    color: rgba(255,255,255,0.6);
    font-family: var(--font-neon);
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    white-space: nowrap;
    padding-bottom: 4px;
    position: relative;
    transition: color var(--duration-fast);
  }
  .cat-btn.active, .cat-btn:hover {
    color: #fff;
  }
  .cat-btn::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: #fff;
    transition: width var(--duration-base) var(--ease-out-power3);
  }
  .cat-btn.active::after {
    width: 100%;
  }

  .filters-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  .filter-label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .search-wrap input {
    background: rgba(0,0,0,0.2);
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff;
    padding: 8px 12px;
    border-radius: 4px;
    font-family: var(--font-body);
  }
  .search-wrap input::placeholder { color: rgba(255,255,255,0.5); }

  .menu-category-section {
    margin-bottom: var(--space-2xl);
    scroll-margin-top: 150px;
  }

  .category-header {
    background: #fff;
    color: var(--ink, #0E0B0A);
    display: inline-block;
    padding: 6px 16px;
    border-radius: 20px;
    font-family: var(--font-neon);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 1rem;
    margin-bottom: var(--space-lg);
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .menu-item {
    padding-bottom: var(--space-md);
    border-bottom: 1px dashed rgba(255,255,255,0.2);
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: 8px;
  }

  .name-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .name-wrap h4 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 500;
  }

  .veg-dot, .nonveg-dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 1px solid #fff;
    background-color: var(--leaf, #2F6B3A);
    border-radius: 2px;
  }
  .nonveg-dot {
    background-color: var(--neon, #FF2E4D);
    clip-path: polygon(50% 10%, 0% 100%, 100% 100%);
  }

  .chop-seal {
    color: var(--saffron, #E8A33D);
    font-size: 1.2rem;
  }

  .item-desc {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.8;
    line-height: 1.4;
  }

  .variants {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .price-pill {
    background: rgba(0,0,0,0.3);
    padding: 4px 10px;
    border-radius: 12px;
    font-family: var(--font-neon);
    font-size: 0.875rem;
  }

  .menu-footer {
    margin-top: var(--space-2xl);
    text-align: center;
  }

  .btn {
    display: inline-block;
    padding: 12px 24px;
    background: #fff;
    color: var(--lacquer, #B71C2B);
    text-decoration: none;
    font-family: var(--font-neon);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 4px;
    font-weight: bold;
    transition: transform var(--duration-fast);
  }
  .btn:hover {
    transform: translateY(-2px);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('menu-search') as HTMLInputElement;
    const vegFilter = document.getElementById('veg-filter') as HTMLInputElement;
    const bestsellerFilter = document.getElementById('bestseller-filter') as HTMLInputElement;
    const items = document.querySelectorAll('.menu-item');
    const categories = document.querySelectorAll('.menu-category-section');
    const catBtns = document.querySelectorAll('.cat-btn');

    function filterMenu() {
      const search = searchInput.value.toLowerCase();
      const showVegOnly = vegFilter.checked;
      const showBestSellers = bestsellerFilter.checked;

      items.forEach((item) => {
        const el = item as HTMLElement;
        const name = el.dataset.name || '';
        const type = el.dataset.type || '';
        const isBestseller = el.dataset.bestseller === 'true';

        const matchSearch = name.includes(search);
        const matchVeg = !showVegOnly || type === 'veg';
        const matchBestseller = !showBestSellers || isBestseller;

        if (matchSearch && matchVeg && matchBestseller) {
          el.style.display = 'block';
        } else {
          el.style.display = 'none';
        }
      });

      // Hide empty categories
      categories.forEach(cat => {
        const catEl = cat as HTMLElement;
        const visibleItems = catEl.querySelectorAll('.menu-item[style="display: block;"], .menu-item:not([style*="display: none"])');
        catEl.style.display = visibleItems.length > 0 ? 'block' : 'none';
      });
    }

    if(searchInput) searchInput.addEventListener('input', filterMenu);
    if(vegFilter) vegFilter.addEventListener('change', filterMenu);
    if(bestsellerFilter) bestsellerFilter.addEventListener('change', filterMenu);

    // Smooth scroll to category
    catBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetId = (e.currentTarget as HTMLElement).dataset.target;
        const targetEl = document.getElementById(targetId!);
        if (targetEl) {
          const y = targetEl.getBoundingClientRect().top + window.scrollY - 160;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      });
    });

    // Scroll spy for active category
    categories.forEach((cat) => {
      ScrollTrigger.create({
        trigger: cat,
        start: "top 170px",
        end: "bottom 170px",
        onToggle: (self) => {
          if (self.isActive) {
            catBtns.forEach(b => b.classList.remove('active'));
            const btn = document.querySelector(`.cat-btn[data-target="${cat.id}"]`);
            if (btn) {
              btn.classList.add('active');
              btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          }
        }
      });
    });

    // Staggered reveal for menu items
    gsap.utils.toArray('.menu-category-section').forEach((section: any) => {
      const sectionItems = section.querySelectorAll('.menu-item');
      gsap.from(sectionItems, {
        scrollTrigger: {
          trigger: section,
          start: 'top 80%',
        },
        y: 20,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power3.out'
      });
    });
  });
</script>

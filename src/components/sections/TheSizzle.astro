---
import { Image } from 'astro:assets';
import sizzlingBrownieImg from '../../assets/img/sizzling-brownie.webp';
---

<section class="the-sizzle" id="sizzle">
  <div class="sizzle-bg">
    <Image src={sizzlingBrownieImg} alt="Sizzling Brownie" class="bg-img" />
    <div class="overlay"></div>
    <div class="particles" aria-hidden="true"></div>
  </div>

  <div class="container sizzle-content">
    <div class="sizzle-header">
      <h2 class="sizzle-title">Some things arrive hissing.</h2>
      <button class="sound-toggle" aria-label="Toggle sizzle sound" data-sound-toggle>
        <span class="icon">🔇</span>
      </button>
      <audio id="sizzle-audio" src="/sounds/sizzle.mp3" loop preload="none"></audio>
    </div>

    <div class="sizzlers-list">
      <div class="sizzler-card">
        <div class="info">
          <h3>Char Siu Cottage Cheese Steak</h3>
          <p>Served with fried rice/noodles and wok-tossed veg</p>
        </div>
        <div class="price">₹429</div>
      </div>
      <div class="sizzler-card">
        <div class="info">
          <h3>Wok Tossed Suckling Chicken <span class="badge">BEST SELLER</span></h3>
          <p>Served with fried rice/noodles and wok-tossed veg</p>
        </div>
        <div class="price">₹449</div>
      </div>
      <div class="sizzler-card">
        <div class="info">
          <h3>Oyster Chili Prawns</h3>
          <p>Served with fried rice/noodles and wok-tossed veg</p>
        </div>
        <div class="price">₹549</div>
      </div>
    </div>
  </div>
</section>

<style>
  .the-sizzle {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: flex-end;
    color: var(--cream);
    overflow: hidden;
    padding: var(--space-2xl) 0;
  }

  .sizzle-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--ink) 0%, rgba(14, 11, 10, 0.4) 100%);
  }

  /* CSS Particle Steam Effect */
  .particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  
  .particles::before, .particles::after {
    content: '';
    position: absolute;
    bottom: -10%;
    width: 10px;
    height: 10px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    filter: blur(8px);
    box-shadow: 
      20vw 10vh 20px 20px rgba(255, 255, 255, 0.1),
      40vw 20vh 15px 15px rgba(255, 255, 255, 0.15),
      60vw 5vh 25px 25px rgba(255, 255, 255, 0.1),
      80vw 15vh 10px 10px rgba(255, 255, 255, 0.2);
    animation: rise 8s infinite ease-in;
  }
  
  .particles::after {
    animation-duration: 12s;
    animation-delay: 2s;
    box-shadow: 
      10vw 15vh 20px 20px rgba(255, 255, 255, 0.1),
      30vw 5vh 15px 15px rgba(255, 255, 255, 0.15),
      50vw 25vh 25px 25px rgba(255, 255, 255, 0.1),
      70vw 10vh 10px 10px rgba(255, 255, 255, 0.2);
  }

  @keyframes rise {
    0% { transform: translateY(0) scale(1); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 0.8; }
    100% { transform: translateY(-80vh) scale(3); opacity: 0; }
  }

  .sizzle-content {
    position: relative;
    z-index: 3;
    width: 100%;
  }

  .sizzle-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .sizzle-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-style: italic;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .sound-toggle {
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    color: white;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-fast) var(--ease-out-power3);
  }

  .sound-toggle:hover {
    background: rgba(255,255,255,0.2);
    transform: scale(1.05);
  }

  .sizzlers-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 800px;
  }

  .sizzler-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md);
    background: rgba(26, 20, 18, 0.6);
    backdrop-filter: blur(10px);
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.05);
  }

  .sizzler-card h3 {
    font-family: var(--font-body);
    font-size: 1.125rem;
    margin: 0 0 4px 0;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .badge {
    font-family: var(--font-neon);
    font-size: 0.7rem;
    background: var(--brick);
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .sizzler-card p {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.8;
  }

  .price {
    font-family: var(--font-neon);
    font-size: 1.25rem;
    color: var(--ember);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import SplitType from 'split-type';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // Text Reveal Animation
    const title = new SplitType('.sizzle-title', { types: 'words, chars' });
    
    gsap.from(title.chars, {
      scrollTrigger: {
        trigger: '.the-sizzle',
        start: 'top 70%',
      },
      opacity: 0,
      y: 20,
      rotateX: -90,
      stagger: 0.02,
      duration: 1,
      ease: 'expo.out'
    });

    gsap.from('.sizzler-card', {
      scrollTrigger: {
        trigger: '.sizzlers-list',
        start: 'top 85%',
      },
      opacity: 0,
      y: 30,
      stagger: 0.15,
      duration: 0.8,
      ease: 'power3.out'
    });

    // Sound Toggle
    const toggleBtn = document.querySelector('[data-sound-toggle]');
    const audio = document.getElementById('sizzle-audio') as HTMLAudioElement;
    let isPlaying = false;

    if(toggleBtn && audio) {
      toggleBtn.addEventListener('click', () => {
        if (isPlaying) {
          audio.pause();
          toggleBtn.querySelector('.icon')!.textContent = '🔇';
        } else {
          audio.play().catch(() => console.log('Audio play failed'));
          toggleBtn.querySelector('.icon')!.textContent = '🔊';
        }
        isPlaying = !isPlaying;
      });
    }
  });
</script>

---
import { Image } from 'astro:assets';
import img1 from '../../assets/img/booths-arches-wide.webp';
import img2 from '../../assets/img/booths-arches-guests.webp';
import img3 from '../../assets/img/arch-column-moody.webp';
---

<section class="story-section" id="story">
  <div class="cjk-bg" aria-hidden="true">客家</div>
  
  <div class="container story-container">
    <div class="story-content">
      <span class="eyebrow">THE SPACE</span>
      <h2 class="story-headline">Brick arches. Amber light. Tiles from a Peranakan dream.</h2>
      
      <div class="story-copy">
        <p>Step through the glass doors on Star Mall's fifth floor and the city fades. Warm amber LEDs trace every terracotta arch, casting pools of light across hand-patterned tiles in saffron, indigo and cream.</p>
        <p>Settle into a tufted leather booth under the geisha mural or grab a cobalt chair by the windows for lunch in the light. Either way, you're in Kolkata's cosiest corner of Asia.</p>
      </div>

      <div class="caption-chips">
        <span class="chip">Tufted leather booths</span>
        <span class="chip">Hand-patterned tiles</span>
        <span class="chip">Full bar</span>
      </div>
    </div>

    <div class="story-visual">
      <div class="arch-frame">
        <div class="arch-images">
          <Image src={img1} alt="Wide view of booths and arches" class="story-img img-1" />
          <Image src={img2} alt="Guests dining under arches" class="story-img img-2" />
          <Image src={img3} alt="Moody lighting near arch column" class="story-img img-3" />
        </div>
        
        <!-- Ember LED Line SVG -->
        <svg class="arch-led" viewBox="0 0 100 150" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0,150 L0,50 C0,22.4 22.4,0 50,0 C77.6,0 100,22.4 100,50 L100,150" class="led-path" />
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .story-section {
    position: relative;
    background-color: var(--soot);
    overflow: hidden;
    padding-block: var(--space-2xl);
  }

  .cjk-bg {
    position: absolute;
    top: 50%;
    left: 5%;
    transform: translateY(-50%);
    font-family: var(--font-cjk, 'Ma Shan Zheng', serif);
    font-size: 40vw;
    line-height: 1;
    color: var(--cream);
    opacity: 0.05;
    pointer-events: none;
    z-index: 0;
    white-space: nowrap;
  }

  .story-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    position: relative;
    z-index: 10;
  }

  .story-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    color: var(--saffron);
    margin-bottom: var(--space-sm);
  }

  .story-headline {
    font-family: var(--font-display, 'Fraunces', serif);
    font-style: italic;
    font-size: var(--text-4xl, clamp(2rem, 5vw, 3.5rem));
    color: var(--cream);
    line-height: 1.1;
    margin-bottom: var(--space-md);
  }

  .story-copy {
    color: var(--cream);
    opacity: 0.8;
    font-size: var(--text-lg, 1.125rem);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }
  
  .story-copy p {
    margin-bottom: var(--space-sm);
  }

  .caption-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .chip {
    padding: 0.25rem 1rem;
    border-radius: 999px;
    background-color: rgba(243, 230, 208, 0.1); /* cream at 10% */
    color: var(--cream);
    font-family: var(--font-neon, 'Josefin Sans', sans-serif);
    font-size: var(--text-sm, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(243, 230, 208, 0.2);
  }

  .story-visual {
    position: relative;
    height: 60vh;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arch-frame {
    position: relative;
    width: 100%;
    max-width: 500px;
    height: 100%;
    clip-path: path("M0,1000 L0,250 C0,112 112,0 250,0 C388,0 500,112 500,250 L500,1000 Z");
    /* Simpler fallback */
    border-radius: 250px 250px 0 0;
    overflow: hidden;
  }

  .arch-images {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .story-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0; /* JS will control visibility */
  }
  
  .story-img.img-1 {
    opacity: 1; /* First one visible by default */
  }

  .arch-led {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  .led-path {
    fill: none;
    stroke: var(--ember, #FF8A3D);
    stroke-width: 2px;
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    filter: drop-shadow(0 0 10px var(--ember));
  }

  /* Desktop layout & pinned settings */
  @media (min-width: 768px) {
    .story-container {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      min-height: 100vh;
    }
    .story-visual {
      height: 100%;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // Parallax background CJK text
    gsap.to('.cjk-bg', {
      yPercent: -20,
      ease: 'none',
      scrollTrigger: {
        trigger: '.story-section',
        start: 'top bottom',
        end: 'bottom top',
        scrub: true
      }
    });

    // Only apply complex pin and cross-fade logic on desktop
    if (window.innerWidth >= 768) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.story-section',
          start: 'top top',
          end: '+=250%',
          pin: true,
          scrub: 1
        }
      });

      // Crossfade images
      tl.to('.img-1', { opacity: 0, duration: 1 })
        .to('.img-2', { opacity: 1, duration: 1 }, "<")
        .to('.img-2', { opacity: 0, duration: 1 }, ">+1")
        .to('.img-3', { opacity: 1, duration: 1 }, "<");

      // Draw LED line alongside the scroll
      tl.to('.led-path', {
        strokeDashoffset: 0,
        duration: 3
      }, 0);
    } else {
      // Mobile simplified animation: Just draw the arch when in view
      gsap.to('.led-path', {
        strokeDashoffset: 0,
        duration: 2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.arch-frame',
          start: 'top 80%'
        }
      });
    }
  });
</script>

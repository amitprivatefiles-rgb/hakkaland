---
import { Image } from 'astro:assets';
import storefrontImg from '../../assets/img/storefront-day.webp';
import { SITE } from '../../config/site';
---

<section class="visit-us" id="visit">
  <div class="container">
    <div class="visit-grid">
      <div class="image-col">
        <div class="arch-frame">
          <Image src={storefrontImg} alt="HakkaLand Storefront" />
        </div>
      </div>
      
      <div class="info-col">
        <p class="eyebrow">VISIT US</p>
        <h2 class="section-title">Find the neon</h2>

        <div class="info-block">
          <h3>Address</h3>
          <p>{SITE.address.street}<br/>{SITE.address.city}, {SITE.address.state} {SITE.address.pincode}</p>
          <p class="highlight">Star Mall, 5th floor &mdash; follow the red glow.</p>
          <p class="note">Mall parking available</p>
        </div>

        <div class="info-block">
          <h3>Contact</h3>
          <p><a href={`tel:${SITE.phone.replace(/[^0-9+]/g, '')}`} class="phone-link">{SITE.phone}</a></p>
        </div>

        <div class="info-block">
          <h3>Hours <span class="disclaimer">// TODO confirm with owner</span></h3>
          <p>{SITE.hours.mon_fri}</p>
          <p>{SITE.hours.sat_sun}</p>
        </div>

        <div class="map-wrap">
          <iframe 
            src={SITE.mapEmbedUrl} 
            width="100%" 
            height="250" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>

        <a href={SITE.mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Get Directions</a>
      </div>
    </div>
  </div>
</section>

<style>
  .visit-us {
    padding: var(--space-2xl) 0;
    background: var(--soot, #1A1412);
    color: var(--cream);
  }

  .visit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 900px) {
    .visit-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .arch-frame {
    width: 100%;
    aspect-ratio: 4/5;
    clip-path: path('M0,200 C0,89.5 89.5,0 200,0 L300,0 C410.5,0 500,89.5 500,200 L500,625 L0,625 Z');
    clip-path: polygon(0% 100%, 100% 100%, 100% 30%, 50% 0%, 0% 30%); /* fallback */
    border-radius: 250px 250px 0 0;
    overflow: hidden;
  }

  .arch-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .eyebrow {
    font-family: var(--font-neon);
    letter-spacing: 0.2em;
    color: var(--ember);
    margin-bottom: var(--space-xs);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: var(--space-xl);
  }

  .info-block {
    margin-bottom: var(--space-lg);
  }

  .info-block h3 {
    font-family: var(--font-neon);
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--saffron);
    margin-bottom: 8px;
  }

  .info-block p {
    margin: 0 0 4px 0;
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .highlight {
    color: var(--ember);
    font-weight: 500;
  }

  .note {
    font-size: 0.9rem !important;
    opacity: 0.7;
    font-style: italic;
  }

  .disclaimer {
    color: #ffaa00;
    font-size: 0.75rem;
    text-transform: none;
    letter-spacing: normal;
    background: rgba(255,170,0,0.2);
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 8px;
    vertical-align: middle;
  }

  .phone-link {
    color: var(--cream);
    text-decoration: none;
    border-bottom: 1px dashed rgba(255,255,255,0.4);
    transition: color 0.3s;
  }
  .phone-link:hover {
    color: var(--neon);
  }

  .map-wrap {
    margin: var(--space-xl) 0;
    border-radius: 12px;
    overflow: hidden;
    filter: invert(0.9) hue-rotate(180deg) brightness(0.8) contrast(1.2);
    transition: filter 0.3s;
  }

  .map-wrap:hover {
    filter: invert(0.9) hue-rotate(180deg) brightness(1) contrast(1.2);
  }

  .btn-primary {
    display: inline-block;
    padding: 14px 32px;
    background: white;
    color: var(--ink);
    font-family: var(--font-neon);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
    transition: background 0.3s, transform 0.3s;
  }
  .btn-primary:hover {
    background: var(--cream);
    transform: translateY(-2px);
  }
</style>

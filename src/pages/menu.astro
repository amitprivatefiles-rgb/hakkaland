---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import VegMark from '../components/VegMark.astro';
import DietMarks from '../components/DietMarks.astro';
import { MENU, rupee, hasVeg, hasNonVeg } from '../lib/menu';
import { SITE } from '../config/site';
---

<Layout title="Menu — HakkaLand, Star Mall Madhyamgram" description="The full HakkaLand menu: soups, momos & bao, satay, starters, sizzlers, tandoori, rice & noodles, Thai curries, Indian gravies & breads, desserts, mocktails and shakes.">
  <header class="bar no-print">
    <div class="container bar-inner">
      <a href="/" class="back">← Back to site</a>
      <button class="btn btn--primary btn--sm" onclick="window.print()">Print menu</button>
    </div>
  </header>

  <main id="main" class="container sheet">
    <div class="head">
      <Logo />
      <p class="tagline">{SITE.tagline}</p>
      <p class="meta">{SITE.address.full}<br />{SITE.phone} · {SITE.hours}</p>
      <p class="legend"><VegMark veg={true} /> Vegetarian <VegMark veg={false} /> Non-vegetarian · Prices in ₹, exclusive of taxes</p>
    </div>

    <div class="cols">
      {MENU.map((c) => (
        <section class="cat">
          <h2>{c.category}</h2>
          {c.note && <p class="note">{c.note}</p>}
          <ul>
            {c.items.map((item) => (
              <li>
                <div class="row">
                  <span class="name"><DietMarks veg={hasVeg(item)} nonveg={hasNonVeg(item)} /> {item.name}{item.bestSeller && <span class="star" title="Best seller">★</span>}</span>
                  {item.variants.length === 1 && <><span class="dots"></span><span class="price">{rupee(item.variants[0].price)}</span></>}
                </div>
                {item.desc && <p class="desc">{item.desc}</p>}
                {item.variants.length > 1 && (
                  <p class="vars">{item.variants.map((v) => `${v.label} ${rupee(v.price)}`).join('  ·  ')}</p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p class="foot">Menu and prices subject to change</p>
  </main>
</Layout>

<style>
  .bar { position: sticky; top: 0; z-index: 10; background: rgba(20, 16, 14, 0.92); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar-inner { height: 64px; display: flex; align-items: center; justify-content: space-between; }
  .back { font-weight: 700; color: var(--muted); }
  .back:hover { color: var(--text); }

  .sheet { padding-block: 56px 80px; }
  .head { text-align: center; padding-bottom: 32px; margin-bottom: 40px; border-bottom: 1px solid var(--line-strong); }
  .head :global(.logo) { font-size: 3rem; }
  .tagline { margin-top: 10px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--amber); }
  .meta { margin-top: 14px; color: var(--muted); font-size: 0.9rem; }
  .legend { margin-top: 16px; display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--muted); }

  .cols { columns: 2 380px; column-gap: 64px; }
  .cat { break-inside: avoid-column; margin-bottom: 40px; }
  .cat h2 { font-size: 1.6rem; padding-bottom: 8px; border-bottom: 2px solid var(--neon); display: inline-block; margin-bottom: 6px; }
  .note { color: var(--muted); font-style: italic; font-size: 0.88rem; }
  .cat ul { margin-top: 10px; }
  .cat li { padding: 9px 0; break-inside: avoid; }
  .row { display: flex; align-items: baseline; gap: 10px; }
  .name { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; }
  .star { color: var(--amber); font-size: 0.85em; }
  .dots { flex: 1; border-bottom: 1px dotted var(--line-strong); transform: translateY(-4px); }
  .price { font-weight: 800; }
  .desc, .vars { padding-left: 22px; font-size: 0.86rem; color: var(--muted); margin-top: 2px; }
  .vars { color: var(--text); opacity: 0.85; }
  .foot { text-align: center; color: var(--muted); font-size: 0.82rem; margin-top: 24px; }

  @media print {
    @page { margin: 12mm; }
    :global(body) { background: #fff !important; color: #111 !important; padding: 0 !important; }
    .no-print { display: none !important; }
    .sheet { padding: 0; max-width: none; }
    .head { border-color: #ccc; margin-bottom: 20px; padding-bottom: 16px; }
    .head :global(.logo-hakka) { color: #111; }
    .head :global(.logo-land) { text-shadow: none; }
    .meta, .legend, .note, .desc, .foot { color: #555; }
    .vars { color: #222; }
    .dots { border-color: #bbb; }
    .cols { columns: 2; column-gap: 32px; font-size: 11px; }
    .cat { margin-bottom: 18px; }
    .cat h2 { font-size: 16px; }
    .cat li { padding: 4px 0; }
  }
</style>

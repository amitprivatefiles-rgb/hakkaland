---
import Layout from '../layouts/Layout.astro';
import menu from '../data/menu.json';
import { SITE } from '../config/site';
---

<Layout title="Menu — HakkaLand">
  <div class="menu-page">
    <div class="print-actions">
      <p>This page is designed for printing. Use Ctrl+P / Cmd+P.</p>
      <div class="actions">
        <a href="/" class="btn btn-ghost">Back to main site</a>
        <button onclick="window.print()" class="btn btn-primary">Print this menu</button>
      </div>
    </div>

    <div class="menu-container">
      <div class="menu-header">
        <h1>{SITE.name}</h1>
        <p class="subtitle">{SITE.tagline || 'Chinese • Asian • Cantonese'}</p>
        <p class="address">{SITE.address}</p>
        <p class="phone">{SITE.phone}</p>
      </div>

      <div class="menu-content">
        {menu.map(category => (
          <section class="menu-category">
            <div class="category-header">
              <h2>{category.name}</h2>
              {category.description && <p class="category-desc">{category.description}</p>}
            </div>
            <div class="category-items">
              {category.items.map(item => (
                <div class="menu-item">
                  <div class="item-header">
                    <div class="item-title-wrap">
                      {item.isVeg ? (
                        <span class="veg-dot" aria-label="Vegetarian"></span>
                      ) : (
                        <span class="nonveg-dot" aria-label="Non-vegetarian"></span>
                      )}
                      <h3 class="item-title">{item.name} {item.isBestSeller && <span class="bestseller-star" aria-label="Best Seller">★</span>}</h3>
                    </div>
                    <div class="item-price">
                      {item.price ? (
                        <span>${item.price}</span>
                      ) : item.variants ? (
                        <div class="variants">
                          {item.variants.map(v => (
                            <span class="variant">
                              <span class="variant-name">{v.name}</span>
                              <span class="variant-price">${v.price}</span>
                            </span>
                          ))}
                        </div>
                      ) : null}
                    </div>
                  </div>
                  {item.description && <p class="item-desc">{item.description}</p>}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .menu-page {
    background-color: var(--cream);
    color: var(--ink);
    min-height: 100vh;
    padding: var(--space-xl) var(--space-m);
    font-family: var(--font-body);
  }

  .print-actions {
    max-width: 800px;
    margin: 0 auto var(--space-xl);
    text-align: center;
    padding: var(--space-m);
    background: white;
    border: 1px solid var(--brick);
    border-radius: 8px;
  }

  .actions {
    display: flex;
    gap: var(--space-m);
    justify-content: center;
    margin-top: var(--space-s);
  }

  .menu-container {
    max-width: 800px;
    margin: 0 auto;
    background: white;
    padding: var(--space-2xl);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .menu-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
    border-bottom: 2px solid var(--ink);
    padding-bottom: var(--space-l);
  }

  .menu-header h1 {
    font-family: var(--font-display);
    font-size: var(--text-mega);
    color: var(--lacquer);
    margin: 0 0 var(--space-xs);
  }

  .subtitle {
    font-family: var(--font-neon);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--text-s);
    margin-bottom: var(--space-s);
  }

  .address, .phone {
    margin: 0;
    color: var(--soot);
  }

  .menu-category {
    margin-bottom: var(--space-xl);
    page-break-inside: avoid;
  }

  .category-header {
    margin-bottom: var(--space-l);
    text-align: center;
  }

  .category-header h2 {
    display: inline-block;
    background-color: var(--lacquer);
    color: var(--cream);
    padding: var(--space-xs) var(--space-m);
    border-radius: 50px;
    font-family: var(--font-neon);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .category-desc {
    margin-top: var(--space-s);
    font-style: italic;
    color: var(--brick);
  }

  .category-items {
    display: grid;
    gap: var(--space-m);
  }

  .menu-item {
    page-break-inside: avoid;
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px dotted var(--soot);
    padding-bottom: var(--space-2xs);
    margin-bottom: var(--space-2xs);
  }

  .item-title-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .item-title {
    font-family: var(--font-display);
    font-size: var(--text-l);
    margin: 0;
    color: var(--ink);
  }

  .bestseller-star {
    color: var(--ember);
    font-size: 0.8em;
  }

  .item-price {
    font-family: var(--font-neon);
    font-size: var(--text-m);
    font-weight: bold;
    color: var(--lacquer);
  }

  .variants {
    display: flex;
    gap: var(--space-m);
  }

  .variant {
    display: flex;
    gap: var(--space-2xs);
  }

  .variant-name {
    color: var(--soot);
    font-size: var(--text-s);
  }

  .item-desc {
    margin: 0;
    font-size: var(--text-s);
    color: var(--soot);
    line-height: 1.4;
  }

  .veg-dot, .nonveg-dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .veg-dot {
    background-color: var(--leaf);
  }

  .nonveg-dot {
    background-color: var(--brick);
  }

  @media print {
    @page { margin: 1.5cm; }
    
    .print-actions {
      display: none !important;
    }
    
    body {
      background: white !important;
    }
    
    .menu-page {
      background: white;
      padding: 0;
    }
    
    .menu-container {
      box-shadow: none;
      padding: 0;
      max-width: none;
    }
    
    .menu-category {
      page-break-inside: avoid;
    }
    
    /* Hide global elements that might bleed in */
    :global(nav), :global(footer), :global(.mobile-action-bar) {
      display: none !important;
    }
  }
</style>

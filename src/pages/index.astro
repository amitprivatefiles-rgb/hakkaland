---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Signatures from '../components/Signatures.astro';
import MenuSection from '../components/MenuSection.astro';
import Bar from '../components/Bar.astro';
import Celebrate from '../components/Celebrate.astro';
import Gallery from '../components/Gallery.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import ReserveDialog from '../components/ReserveDialog.astro';
import MobileBar from '../components/MobileBar.astro';
---

<Layout>
  <Nav />
  <main id="main">
    <Hero />
    <About />
    <Signatures />
    <MenuSection />
    <Bar />
    <Celebrate />
    <Gallery />
    <Visit />
  </main>
  <Footer />
  <ReserveDialog />
  <MobileBar />
</Layout>
